+#include "hyper_lpr_sdk_memory.h"
+
+P_HLPR_Context HLPR_CreateContextFromEmbeddedModels(
+        P_HLPR_ContextConfiguration configuration) {
+    P_HLPR_Context context = nullptr;
+    if (configuration != nullptr) {
+        static char embedded_models_path[] = "embedded://";
+        HLPR_ContextConfiguration embedded_configuration = *configuration;
+        embedded_configuration.models_path = embedded_models_path;
+        context = HLPR_CreateContext(&embedded_configuration);
+    }
+    return context;
+}
