+++ b/cpp/src/embedded_model.cpp
@@ -0,0 +1,70 @@
+#include "embedded_model.h"
+
+#include <climits>
+#include <cstddef>
+#include <cstring>
+
+extern "C" {
+extern const unsigned char _binary_b320_backbone_h_mnn_start[];
+extern const unsigned char _binary_b320_backbone_h_mnn_end[];
+extern const unsigned char _binary_b320_header_h_mnn_start[];
+extern const unsigned char _binary_b320_header_h_mnn_end[];
+extern const unsigned char _binary_b640x_backbone_h_mnn_start[];
+extern const unsigned char _binary_b640x_backbone_h_mnn_end[];
+extern const unsigned char _binary_b640x_head_h_mnn_start[];
+extern const unsigned char _binary_b640x_head_h_mnn_end[];
+extern const unsigned char _binary_litemodel_cls_96xh_mnn_start[];
+extern const unsigned char _binary_litemodel_cls_96xh_mnn_end[];
+extern const unsigned char _binary_rpv3_mdict_160h_mnn_start[];
+extern const unsigned char _binary_rpv3_mdict_160h_mnn_end[];
+}
+
+namespace hyper {
+namespace {
+
+struct EmbeddedModel {
+    const char* name;
+    const unsigned char* begin;
+    const unsigned char* end;
+};
+
+const EmbeddedModel kEmbeddedModels[] = {
+    {"b320_backbone_h.mnn", _binary_b320_backbone_h_mnn_start,
+     _binary_b320_backbone_h_mnn_end},
+    {"b320_header_h.mnn", _binary_b320_header_h_mnn_start,
+     _binary_b320_header_h_mnn_end},
+    {"b640x_backbone_h.mnn", _binary_b640x_backbone_h_mnn_start,
+     _binary_b640x_backbone_h_mnn_end},
+    {"b640x_head_h.mnn", _binary_b640x_head_h_mnn_start,
+     _binary_b640x_head_h_mnn_end},
+    {"litemodel_cls_96xh.mnn", _binary_litemodel_cls_96xh_mnn_start,
+     _binary_litemodel_cls_96xh_mnn_end},
+    {"rpv3_mdict_160h.mnn", _binary_rpv3_mdict_160h_mnn_start,
+     _binary_rpv3_mdict_160h_mnn_end},
+};
+
+}  // namespace
+
+bool ResolveEmbeddedModel(const std::string& model_uri,
+                          const unsigned char** model_data,
+                          int* model_size) {
+    static const char kEmbeddedPrefix[] = "embedded://";
+    bool resolved = false;
+    if (model_data != nullptr && model_size != nullptr &&
+        model_uri.compare(0, sizeof(kEmbeddedPrefix) - 1U,
+                          kEmbeddedPrefix) == 0) {
+        const char* model_name = model_uri.c_str() + sizeof(kEmbeddedPrefix) - 1U;
+        for (const EmbeddedModel& model : kEmbeddedModels) {
+            const ptrdiff_t size = model.end - model.begin;
+            if (!resolved && std::strcmp(model.name, model_name) == 0 &&
+                size > 0 && size <= INT_MAX) {
+                *model_data = model.begin;
+                *model_size = static_cast<int>(size);
+                resolved = true;
+            }
+        }
+    }
+    return resolved;
+}
+
+}  // namespace hyper
