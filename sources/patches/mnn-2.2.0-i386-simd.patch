+        target_compile_options(MNNCPU PRIVATE -msse4.1)
+    endif()
     option(MNN_AVX512_VNNI "Enable AVX512 VNNI" ON)
     FILE(GLOB MNN_X8664_SRC ${CMAKE_CURRENT_LIST_DIR}/*)
