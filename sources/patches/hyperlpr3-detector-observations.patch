+
+#include <array>
+#include <cstddef>
+
+#include "hyper_lpr_common.h"
+
+namespace hyper {
+
+const size_t kDetectionObservationCapacity = 5U;
+const size_t kDetectionObservationTextSize = 64U;
+
+struct DetectionObservation {
+    float detector_confidence;
+    float ocr_confidence;
+    float x1;
+    float y1;
+    float x2;
+    float y2;
+    int plate_type;
+    bool ocr_valid;
+    char plate_utf8[kDetectionObservationTextSize];
+};
+
+typedef std::array<DetectionObservation, kDetectionObservationCapacity>
+        DetectionObservationList;
+
+bool InitializeDetectionObservation(const PlateLocation& location,
+                                    int image_width,
+                                    int image_height,
+                                    DetectionObservation* observation);
+
+void ApplyDetectionObservationOcr(bool inference_succeeded,
+                                  const TextLine& text_line,
+                                  float confidence_threshold,
+                                  PlateType plate_type,
+                                  DetectionObservation* observation);
+
+}  // namespace hyper
+
+#endif
