diff --git a/cpp/c_api/hyper_lpr_sdk_observation.cc b/cpp/c_api/hyper_lpr_sdk_observation.cc
new file mode 100644
--- /dev/null
+++ b/cpp/c_api/hyper_lpr_sdk_observation.cc
@@ -0,0 +1,76 @@
+#include "hyper_lpr_sdk_observation.h"
+
+#include "hyper_lpr_sdk_internal.h"
+
+#include <algorithm>
+#include <cstring>
+
+static_assert(sizeof(HLPR_DetectionObservation) == 100U,
+              "LaneApp observation item ABI changed");
+static_assert(sizeof(HLPR_DetectionObservationBatch) == 516U,
+              "LaneApp observation batch ABI changed");
+static_assert(hyper::kDetectionObservationCapacity ==
+                  HLPR_MAX_DETECTION_OBSERVATIONS,
+              "public and internal observation capacities differ");
+
+namespace {
+
+void ResetObservationBatch(P_HLPR_DetectionObservationBatch observations) {
+    std::memset(observations, 0, sizeof(*observations));
+    observations->abi_version = HLPR_DETECTION_OBSERVATION_ABI_VERSION;
+}
+
+}  // namespace
+
+HREESULT HLPR_ContextObserveDetections(
+        P_HLPR_Context ctx, P_HLPR_DataBuffer buffer,
+        P_HLPR_DetectionObservationBatch observations) {
+    if (observations == nullptr) {
+        return Err;
+    }
+    ResetObservationBatch(observations);
+    if (ctx == nullptr || buffer == nullptr ||
+        ctx->impl.getMInitStatus() != hyper::hRetOk) {
+        return Err;
+    }
+    try {
+        ctx->impl(buffer->impl);
+        const hyper::DetectionObservationList& source =
+                ctx->impl.getMDetectionObservations();
+        const size_t count = (std::min)(
+                ctx->impl.getMDetectionObservationCount(),
+                static_cast<size_t>(HLPR_MAX_DETECTION_OBSERVATIONS));
+        observations->count = static_cast<uint32_t>(count);
+        observations->inference_width = buffer->impl.GetWidth();
+        observations->inference_height = buffer->impl.GetHeight();
+        if (buffer->impl.GetRotationMode() == hyper::ROTATION_90 ||
+            buffer->impl.GetRotationMode() == hyper::ROTATION_270) {
+            std::swap(observations->inference_width,
+                      observations->inference_height);
+        }
+        for (size_t index = 0U; index < count; ++index) {
+            const hyper::DetectionObservation& input = source[index];
+            HLPR_DetectionObservation& output = observations->items[index];
+            output.struct_size = sizeof(output);
+            output.flags = HLPR_DETECTION_OBSERVATION_DETECTED;
+            output.detector_confidence = input.detector_confidence;
+            output.ocr_confidence = input.ocr_confidence;
+            output.x1 = input.x1;
+            output.y1 = input.y1;
+            output.x2 = input.x2;
+            output.y2 = input.y2;
+            output.plate_type = input.plate_type;
+            if (input.ocr_valid) {
+                output.flags |= HLPR_DETECTION_OBSERVATION_OCR_VALID;
+                std::memcpy(output.plate_utf8, input.plate_utf8,
+                            sizeof(output.plate_utf8));
+            } else {
+                output.plate_utf8[0] = '\0';
+            }
+        }
+        return Ok;
+    } catch (...) {
+        ResetObservationBatch(observations);
+        return Err;
+    }
+}
diff --git a/cpp/c_api/hyper_lpr_sdk_observation.h b/cpp/c_api/hyper_lpr_sdk_observation.h
new file mode 100644
--- /dev/null
+++ b/cpp/c_api/hyper_lpr_sdk_observation.h
@@ -0,0 +1,55 @@
+#ifndef HYPER_LPR_SDK_OBSERVATION_H
+#define HYPER_LPR_SDK_OBSERVATION_H
+
+#include "hyper_lpr_sdk.h"
+
+#define HLPR_DETECTION_OBSERVATION_TEXT_SIZE 64U
+#define HLPR_DETECTION_OBSERVATION_ABI_VERSION 1U
+#define HLPR_MAX_DETECTION_OBSERVATIONS 5U
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    HLPR_DETECTION_OBSERVATION_DETECTED = 0x01U,
+    HLPR_DETECTION_OBSERVATION_OCR_VALID = 0x02U
+};
+
+typedef struct HLPR_DetectionObservation {
+    uint32_t struct_size;
+    uint32_t flags;
+    float detector_confidence;
+    float ocr_confidence;
+    float x1;
+    float y1;
+    float x2;
+    float y2;
+    int plate_type;
+    char plate_utf8[HLPR_DETECTION_OBSERVATION_TEXT_SIZE];
+} HLPR_DetectionObservation, *P_HLPR_DetectionObservation;
+
+typedef struct HLPR_DetectionObservationBatch {
+    uint32_t abi_version;
+    uint32_t count;
+    int inference_width;
+    int inference_height;
+    HLPR_DetectionObservation items[HLPR_MAX_DETECTION_OBSERVATIONS];
+} HLPR_DetectionObservationBatch, *P_HLPR_DetectionObservationBatch;
+
+/************************************************************************
+* Run the normal HyperLPR pipeline and expose detector observations before
+* OCR filtering. The caller owns a fixed-capacity result and no SDK array is
+* returned. OCR_VALID is set only when the existing confidence and minimum
+* text-length gates pass; otherwise plate_utf8 starts with a NUL byte.
+************************************************************************/
+HYPER_CAPI_EXPORT extern HREESULT HLPR_ContextObserveDetections(
+        P_HLPR_Context ctx,
+        P_HLPR_DataBuffer buffer,
+        P_HLPR_DetectionObservationBatch observations);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
