--- /dev/null
+++ b/cpp/src/context_module/detection_observation.cpp
@@ -0,0 +1,70 @@
+#include "detection_observation.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+namespace hyper {
+
+bool InitializeDetectionObservation(const PlateLocation& location,
+                                    int image_width, int image_height,
+                                    DetectionObservation* observation) {
+    if (observation == nullptr) {
+        return false;
+    }
+    std::memset(observation, 0, sizeof(*observation));
+    observation->plate_type = static_cast<int>(PlateType::UNKNOWN);
+    if (image_width <= 0 || image_height <= 0 ||
+        !std::isfinite(location.det_confidence) ||
+        location.det_confidence < 0.0f ||
+        location.det_confidence > 1.0f ||
+        !std::isfinite(location.x1) || !std::isfinite(location.y1) ||
+        !std::isfinite(location.x2) || !std::isfinite(location.y2)) {
+        return false;
+    }
+    const float width = static_cast<float>(image_width);
+    const float height = static_cast<float>(image_height);
+    const float x1 = (std::max)(0.0f, (std::min)(location.x1, width));
+    const float y1 = (std::max)(0.0f, (std::min)(location.y1, height));
+    const float x2 = (std::max)(0.0f, (std::min)(location.x2, width));
+    const float y2 = (std::max)(0.0f, (std::min)(location.y2, height));
+    if (x2 <= x1 || y2 <= y1) {
+        return false;
+    }
+    observation->detector_confidence = location.det_confidence;
+    observation->x1 = x1;
+    observation->y1 = y1;
+    observation->x2 = x2;
+    observation->y2 = y2;
+    return true;
+}
+
+void ApplyDetectionObservationOcr(bool inference_succeeded,
+                                  const TextLine& text_line,
+                                  float confidence_threshold,
+                                  PlateType plate_type,
+                                  DetectionObservation* observation) {
+    if (observation == nullptr) {
+        return;
+    }
+    observation->ocr_valid = false;
+    observation->ocr_confidence = 0.0f;
+    observation->plate_type = static_cast<int>(PlateType::UNKNOWN);
+    observation->plate_utf8[0] = '\0';
+    if (!inference_succeeded || !std::isfinite(text_line.average_score)) {
+        return;
+    }
+    observation->ocr_confidence = text_line.average_score;
+    if (text_line.average_score < confidence_threshold ||
+        text_line.average_score < 0.0f || text_line.average_score > 1.0f ||
+        text_line.code.size() < 8U ||
+        text_line.code.size() >= sizeof(observation->plate_utf8)) {
+        return;
+    }
+    std::memcpy(observation->plate_utf8, text_line.code.c_str(),
+                text_line.code.size() + 1U);
+    observation->plate_type = static_cast<int>(plate_type);
+    observation->ocr_valid = true;
+}
+
+}  // namespace hyper
